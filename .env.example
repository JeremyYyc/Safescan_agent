# 应用
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DEFAULT_LOCALE=zh-CN
LLM_OUTPUT_LANGUAGE=Simplified Chinese
POSTGRES_TIMEZONE=Asia/Shanghai
VITE_ENABLE_LANGUAGE_SWITCH=true
APP_LOG_LEVEL=INFO

# PostgreSQL：应用使用容器内部 db:5432；DataGrip 通过 127.0.0.1 的主机端口访问。
# 仅绑定本机回环地址，不向局域网或公网开放。URL 密码需 URL 编码。
# 六个 schema 位于同一个 safescan 数据库中，不要为每个 schema 配置独立 DATABASE_URL。
DATABASE_URL=postgresql+psycopg://safescan:change-me@db:5432/safescan
POSTGRES_DB=safescan
POSTGRES_USER=safescan
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
POSTGRES_SERVICE_SCHEMAS=identity_access,property_leasing,maintenance,inspection_report,knowledge,staff_agent
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT=10

# Qwen 模型；保留现有分层与模型名
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL_L1=qwen-turbo-latest
ALIBABA_MODEL_L2=qwen-plus-latest
ALIBABA_MODEL_L3=qwen-max-latest
ALIBABA_MODEL_VL=qwen3-vl-plus
AGENT_MAX_CONCURRENCY=5
QWEN_CONNECT_TIMEOUT_SECONDS=10
QWEN_READ_TIMEOUT_SECONDS=120

# Tool Calling：每次模型交互的最大工具轮数、总调用数、回传字符数
TOOL_MAX_ROUNDS=4
TOOL_MAX_CALLS=12
TOOL_MAX_OUTPUT_CHARS=64000

# 鉴权（请设置随机长密钥；不得进入浏览器）
AUTH_SECRET=
PUBLIC_ID_SECRET=
AUTH_EXPIRE_HOURS=8
AUTH_ISSUER=safescan-identity
AUTH_AUDIENCE=safescan-api
IDENTITY_INTERNAL_AUDIENCE=safescan-identity-internal
IDENTITY_EXPOSE_ACTION_TOKENS=false
# Identity token/session 生命周期（秒）与同源 Cookie 名称。
IDENTITY_ACCESS_TOKEN_SECONDS=900
IDENTITY_REFRESH_TOKEN_SECONDS=2592000
IDENTITY_SESSION_IDLE_SECONDS=604800
IDENTITY_ACTION_TOKEN_SECONDS=3600
IDENTITY_REFRESH_COOKIE=safescan_refresh
IDENTITY_CSRF_COOKIE=safescan_csrf
# 本地同源部署留空；仅在明确的共享父域部署中设置。
IDENTITY_COOKIE_DOMAIN=
# 账号删除 Tombstone 使用独立 HMAC pepper；生产环境必须设置至少 24 字符的随机值。
# 轮换时递增 version，并按 `version:pepper` 逗号分隔保留仍受支持的历史 pepper。
IDENTITY_DELETION_PEPPER=
IDENTITY_DELETION_PEPPER_VERSION=1
IDENTITY_DELETION_PREVIOUS_PEPPERS=
IDENTITY_DELETION_DEPENDENCY_TIMEOUT_SECONDS=1.5
PROPERTY_LEASING_INTERNAL_URL=http://property-leasing-service:8002
MAINTENANCE_INTERNAL_URL=http://maintenance-service:8003
# 基础设施骨架仍兼容现有 bootstrap；Identity 功能分支迁入 12 人 seed 后关闭该入口。
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=
IDENTITY_BOOTSTRAP_ADMIN_NAME=SafeScan Administrator
IDENTITY_BOOTSTRAP_ADMIN_STAFF_CODE=ADMIN001
# 仅开发/测试环境；Identity 功能分支负责实现并验证，生产必须为 false。
IDENTITY_SEED_STAFF=false

# Property Leasing delegated-token audience and Identity service credential.
PROPERTY_LEASING_AUDIENCE=property-leasing-service
PROPERTY_LEASING_IDENTITY_SERVICE_TOKEN=
IDENTITY_BASE_URL=http://identity-access-service:8001
IDENTITY_TIMEOUT_SECONDS=2
IDEMPOTENCY_TTL_HOURS=72
LEASE_LIFECYCLE_POLL_SECONDS=5
# Optional deterministic assignment pool. Empty keeps a contact case unassigned.
LEASING_CONSULTANT_STAFF_IDS=
PROPERTY_MANAGER_STAFF_IDS=
PROPERTY_LEASING_SEED=false
PROPERTY_EVENT_SINK_URL=
PROPERTY_EVENT_SINK_TOKEN=
PROPERTY_OUTBOX_POLL_SECONDS=1

# Redis 只在 Compose 内网开放，用于缓存和流量治理；业务持久状态仍以 PostgreSQL 为准。
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# Portal BFF pooled HTTP clients and deadlines.
PORTAL_CONNECT_TIMEOUT_SECONDS=0.3
PORTAL_REQUEST_TIMEOUT_SECONDS=1.2
PORTAL_POOL_CONNECTIONS=50
PORTAL_POOL_KEEPALIVE=20
# Machine credential used by Portal APIs for Identity token exchange.
PORTAL_SERVICE_TOKEN=

# 私有 MinIO：应用连接 Nginx；仅 Nginx 加入 MinIO 存储网络
MINIO_ENDPOINT=gateway:9000
MINIO_ACCESS_KEY=safescan
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_MEDIA_BUCKET=safescan-media
MINIO_DERIVED_BUCKET=safescan-derived
MINIO_REPORTS_BUCKET=safescan-reports
# 单个 MinIO 上游的持久连接池；超出时等待，避免默认 maxsize=1 反复丢弃连接
MINIO_POOL_MAXSIZE=32

# 长视频处理（100 分钟、8 GiB、最高 4K）；源视频通过临时文件流式处理，不整体载入内存
MAX_UPLOAD_BYTES=8589934592
UPLOAD_MAX_CONCURRENCY=1
MAX_VIDEO_MEMORY_BYTES=536870912
MAX_VIDEO_SECONDS=6000
MAX_VIDEO_PIXELS=8294400
# 仍按每秒最多 1 帧采样，但长视频自适应稀疏到最多 1200 帧
MAX_EXTRACTED_FRAMES=1200
VIDEO_FRAME_SAMPLE_RATE=1.0
VIDEO_TOOL_TIMEOUT_SECONDS=3600
VIDEO_MAX_REPRESENTATIVE_FRAMES=30
VIDEO_MAX_FRAMES_PER_ROOM=5
VIDEO_IO_CHUNK_BYTES=8388608
VIDEO_WORKER_CONCURRENCY=1

# 持久化报告任务：Compose 使用独立 report-worker，因此关闭 backend 内联 worker
REPORT_WORKER_INLINE=false
REPORT_JOB_POLL_SECONDS=0.25
REPORT_JOB_EVENT_POLL_SECONDS=0.2
REPORT_JOB_LEASE_SECONDS=180
REPORT_PIPELINE_VERSION=langgraph-v1

# Nginx 唯一入口（宿主机仅绑定 127.0.0.1）；前端固定同源 /api，无 CORS
GATEWAY_PORT=8080
GATEWAY_S3_PORT=9000
GATEWAY_CONSOLE_PORT=9001
# 修改控制台端口时同步更新此 URL；这是控制台自身跳转，不是应用 API 地址
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
# 服务实际地址只出现在网关路由中；领域服务不直接暴露给浏览器。
NGINX_IDENTITY_UPSTREAM=identity-access-service:8001
NGINX_STAFF_BFF_UPSTREAM=staff-portal-api:8006
NGINX_TENANT_BFF_UPSTREAM=tenant-portal-api:8007
NGINX_STAFF_WEB_UPSTREAM=staff-web:80
NGINX_TENANT_WEB_UPSTREAM=tenant-web:80
NGINX_MINIO_S3_UPSTREAM=minio:9000
NGINX_MINIO_CONSOLE_UPSTREAM=minio:9001
# 旧报告应用 Settings 的兼容字段；P0 默认 Gateway 不读取，迁移完成前不可删除。
NGINX_BACKEND_UPSTREAM=backend:8000
NGINX_FRONTEND_UPSTREAM=frontend:80

# 开发测试
UUID7_FORCE_FALLBACK=false
