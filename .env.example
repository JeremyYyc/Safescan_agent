# 应用
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DEFAULT_LOCALE=zh-CN
LLM_OUTPUT_LANGUAGE=Simplified Chinese
POSTGRES_TIMEZONE=Asia/Shanghai
VITE_ENABLE_LANGUAGE_SWITCH=true
APP_LOG_LEVEL=INFO

# PostgreSQL：应用使用容器内部 db:5432；DataGrip 通过 127.0.0.1 的主机端口访问。
# 仅绑定本机回环地址，不向局域网或公网开放。URL 密码需 URL 编码。
DATABASE_URL=postgresql+psycopg://safescan:change-me@db:5432/safescan
POSTGRES_DB=safescan
POSTGRES_USER=safescan
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT=10

# Qwen 模型；保留现有分层与模型名
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL_L1=qwen-turbo-latest
ALIBABA_MODEL_L2=qwen-plus-latest
ALIBABA_MODEL_L3=qwen-max-latest
ALIBABA_MODEL_VL=qwen3-vl-plus
AGENT_MAX_CONCURRENCY=5
QWEN_CONNECT_TIMEOUT_SECONDS=10
QWEN_READ_TIMEOUT_SECONDS=120

# Tool Calling：每次模型交互的最大工具轮数、总调用数、回传字符数
TOOL_MAX_ROUNDS=4
TOOL_MAX_CALLS=12
TOOL_MAX_OUTPUT_CHARS=64000

# 鉴权（请设置随机长密钥；不得进入浏览器）
AUTH_SECRET=
PUBLIC_ID_SECRET=
AUTH_EXPIRE_HOURS=8

# 私有 MinIO：应用连接 Nginx；仅 Nginx 加入 MinIO 存储网络
MINIO_ENDPOINT=gateway:9000
MINIO_ACCESS_KEY=safescan
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_MEDIA_BUCKET=safescan-media
MINIO_DERIVED_BUCKET=safescan-derived
MINIO_REPORTS_BUCKET=safescan-reports
# 单个 MinIO 上游的持久连接池；超出时等待，避免默认 maxsize=1 反复丢弃连接
MINIO_POOL_MAXSIZE=32

# 长视频处理（100 分钟、8 GiB、最高 4K）；源视频通过临时文件流式处理，不整体载入内存
MAX_UPLOAD_BYTES=8589934592
UPLOAD_MAX_CONCURRENCY=1
MAX_VIDEO_MEMORY_BYTES=536870912
MAX_VIDEO_SECONDS=6000
MAX_VIDEO_PIXELS=8294400
# 仍按每秒最多 1 帧采样，但长视频自适应稀疏到最多 1200 帧
MAX_EXTRACTED_FRAMES=1200
VIDEO_FRAME_SAMPLE_RATE=1.0
VIDEO_TOOL_TIMEOUT_SECONDS=3600
VIDEO_MAX_REPRESENTATIVE_FRAMES=30
VIDEO_MAX_FRAMES_PER_ROOM=5
VIDEO_IO_CHUNK_BYTES=8388608
VIDEO_WORKER_CONCURRENCY=1
# PostgreSQL-backed report queue: worker poll interval and an expired-worker lease.
REPORT_JOB_POLL_SECONDS=1
REPORT_JOB_LEASE_SECONDS=7200

# Nginx 唯一入口（宿主机仅绑定 127.0.0.1）；前端固定同源 /api，无 CORS
GATEWAY_PORT=8080
GATEWAY_S3_PORT=9000
GATEWAY_CONSOLE_PORT=9001
# 修改控制台端口时同步更新此 URL；这是控制台自身跳转，不是应用 API 地址
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
# 服务实际地址只出现在网关路由中；未来 worker HTTP / Redis TCP 分别扩展
NGINX_BACKEND_UPSTREAM=backend:8000
NGINX_FRONTEND_UPSTREAM=frontend:80
NGINX_MINIO_S3_UPSTREAM=minio:9000
NGINX_MINIO_CONSOLE_UPSTREAM=minio:9001

# 开发测试
UUID7_FORCE_FALLBACK=false
