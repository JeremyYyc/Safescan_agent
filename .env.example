# SafeScan root Compose environment template. Copy to .env for local Docker use.
# Never commit .env, .env.test, .env.staging or .env.production.

# Qwen / DashScope
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_FAST=qwen3.7-flash
QWEN_MODEL_STANDARD=qwen3.7-plus-2026-05-26
QWEN_MODEL_REASONING=qwen3.8-max
QWEN_MODEL_VISION=qwen3.7-plus-2026-05-26
QWEN_MODEL_OCR=qwen3.5-ocr
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSION=1024
QWEN_RERANK_MODEL=qwen3-rerank

# Legacy compatibility; migrate callers to QWEN_*.
DASHSCOPE_API_KEY=
ALIBABA_MODEL_L1=qwen3.7-flash
ALIBABA_MODEL_L2=qwen3.7-plus-2026-05-26
ALIBABA_MODEL_L3=qwen3.8-max
ALIBABA_MODEL_VL=qwen3.7-plus-2026-05-26

AGENT_MAX_CONCURRENCY=5
OUTPUT_DIR=/app/uploads

# Compose service-to-service DSN. Use db, not localhost, inside containers.
MYSQL_DATABASE=safescan_agent
MYSQL_ROOT_PASSWORD=change-me
DATABASE_URL=mysql+pymysql://root:change-me@db:3306/safescan_agent?charset=utf8mb4

AUTH_SECRET=change-me-to-a-long-random-secret
AUTH_EXPIRE_HOURS=8
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

LANGGRAPH_ENABLED=false
RAG_SAFETY_ENABLED=false
REPORT_CITATIONS_ENABLED=false
HITL_ENABLED=false
QWEN_MODEL_CANARY_ENABLED=false
VITE_API_BASE=http://localhost:8000
