# 应用
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_LOG_LEVEL=INFO

# 数据库（P1 为 MySQL；P2 替换）
DATABASE_URL=mysql+pymysql://root:change-me@db:3306/safescan_agent
MYSQL_DATABASE=safescan_agent
MYSQL_ROOT_PASSWORD=change-me

# Qwen 模型；保留现有分层与模型名
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL_L1=qwen-turbo-latest
ALIBABA_MODEL_L2=qwen-plus-latest
ALIBABA_MODEL_L3=qwen-max-latest
ALIBABA_MODEL_VL=qwen3-vl-plus
AGENT_MAX_CONCURRENCY=5

# 鉴权（请设置随机长密钥；不得进入浏览器）
AUTH_SECRET=
PUBLIC_ID_SECRET=
AUTH_EXPIRE_HOURS=8

# 文件（P3 替换为 MinIO）
OUTPUT_DIR=uploads

# 本地入口；VITE_API_BASE 是唯一前端公开配置，留空走同源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=
VITE_API_BASE=
GATEWAY_PORT=8080

# 开发测试
UUID7_FORCE_FALLBACK=false
