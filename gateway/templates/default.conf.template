# Request-time DNS lets gateway start before backend (no dependency cycle).
server {
    listen 80;
    server_name _;
    absolute_redirect off;
    client_max_body_size ${NGINX_MAX_BODY_SIZE};
    set $identity_upstream ${NGINX_IDENTITY_UPSTREAM};
    set $staff_bff_upstream ${NGINX_STAFF_BFF_UPSTREAM};
    set $tenant_bff_upstream ${NGINX_TENANT_BFF_UPSTREAM};
    set $staff_web_upstream ${NGINX_STAFF_WEB_UPSTREAM};
    set $tenant_web_upstream ${NGINX_TENANT_WEB_UPSTREAM};
    location = /gateway-health { access_log off; return 200 'ok\n'; }
    location = / { return 302 /tenant/; }
    location ^~ /api/v1/auth/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection "";
        proxy_pass http://$identity_upstream$request_uri;
    }
    location ^~ /api/v1/me {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection "";
        proxy_pass http://$identity_upstream$request_uri;
    }
    location ^~ /api/v1/iam/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection "";
        proxy_pass http://$identity_upstream$request_uri;
    }
    location ^~ /api/v1/staff/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection "";
        proxy_pass http://$staff_bff_upstream$request_uri;
    }
    location ^~ /api/v1/tenant/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection "";
        proxy_pass http://$tenant_bff_upstream$request_uri;
    }
    location = /staff { return 308 /staff/; }
    location ^~ /staff/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        rewrite ^/staff/(.*)$ /$1 break;
        proxy_pass http://$staff_web_upstream$uri$is_args$args;
    }
    location = /tenant { return 308 /tenant/; }
    location ^~ /tenant/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        rewrite ^/tenant/(.*)$ /$1 break;
        proxy_pass http://$tenant_web_upstream$uri$is_args$args;
    }
    include /etc/nginx/routes.d/*.conf;
    location / {
        default_type application/json;
        return 404 '{"error":{"code":"resource_not_found","message":"Resource not found"}}';
    }
}

# SigV4 requires the original URI, query and Host INCLUDING port. No prefix.
server {
    listen 9000;
    # Nginx error records can contain signed query strings. Status-only access
    # logging remains enabled; inspect MinIO responses for S3 error details.
    error_log /dev/null;
    server_name _;
    client_max_body_size 0;
    ignore_invalid_headers off;
    set $minio_s3_upstream ${NGINX_MINIO_S3_UPSTREAM};
    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection "";
        proxy_pass http://$minio_s3_upstream$request_uri;
    }
}

server {
    listen 9001;
    server_name _;
    client_max_body_size 0;
    set $minio_console_upstream ${NGINX_MINIO_CONSOLE_UPSTREAM};
    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://$minio_console_upstream$request_uri;
    }
}
