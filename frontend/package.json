{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "staff:build": "vite build apps/staff-web --base=/staff/ --outDir=dist/staff-web",
    "staff:lint": "eslint apps/staff-web/src --max-warnings=0",
    "staff:test": "vitest run --config apps/staff-web/vitest.config.ts",
    "staff:typecheck": "tsc -p apps/staff-web/tsconfig.json --noEmit",
    "staff:check": "npm run staff:lint && npm run staff:typecheck && npm run staff:test && npm run staff:build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.0.11",
    "marked": "^12.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
