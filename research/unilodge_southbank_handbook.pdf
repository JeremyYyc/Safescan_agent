                                    <select name="location_id" id="select_city" class="js-select-ajax" data-placeholder="City you want to study in?" data-dependance="university_id" data-module="location" data-url="/json/search/13/1/locations.json" data-format="locationsFormatState" searchable></select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="select select--alt mt-3">
                                    <label class="d-none" for="select_university">Which University are you studying at?</label>

                                    <select name="university_id" id="select_university" class="js-select-ajax" data-placeholder="Which University are you studying at?" data-dependance="location_id" data-module="university" data-url="/json/search/13/1/universities.json" searchable></select>
                                </div><!-- /.select -->
                            </div>
                        </div>

